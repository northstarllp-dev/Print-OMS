{
  "name": "printoms-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 --turbo",
    "dev:printoms": "node scripts/dev_client.js printoms",
    "dev:printec": "node scripts/dev_client.js printec",
    "dev:board": "node scripts/dev_client.js the-board-company",
    "dev:hitech": "node scripts/dev_client.js hitech-vision",
    "client:new": "node scripts/scaffold_client.js",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "db:reset": "npx supabase db reset",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:dump:remote": "npx supabase db dump --linked -f supabase/remote-dump/schema.sql --yes && npx supabase db dump --linked --data-only --use-copy -f supabase/remote-dump/data.sql --yes -x storage.buckets_vectors -x storage.buckets_analytics -x storage.vector_indexes -x storage.s3_multipart_uploads -x storage.s3_multipart_uploads_parts",
    "db:restore:local": "node scripts/restore-remote-dump.mjs",
    "db:sync-storage": "node scripts/sync-storage-to-local.mjs",
    "db:clone:dev": "npm run db:dump:remote && npm run db:restore:local && npm run db:sync-storage",
    "db:seed:e2e": "node scripts/seed-e2e-users.mjs",
    "env:test": "node scripts/generate-env-test.mjs",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/openai": "^4.0.16",
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "ai": "^7.0.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glob": "^13.0.6",
    "lucide-react": "*",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^3.8.3",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "supabase": "^2.106.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
